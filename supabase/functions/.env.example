# cp to .env, fill in your OpenRouter API key.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Any OpenRouter model id. Default is fine for demos.
# Alternatives: anthropic/claude-sonnet-4.6, openai/gpt-4o, google/gemini-2.5-flash
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
