# Supabase local (defaults from `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-output-of-supabase-status
SUPABASE_SERVICE_ROLE_KEY=replace-with-output-of-supabase-status
# Postgres connection string used only by the seeder (COPY-based ingestion).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Seeder
SEED=42

# MCP server -> BFF
COHORT_LENS_URL=http://127.0.0.1:54321/functions/v1
COHORT_LENS_JWT=paste-a-signed-user-jwt-here
COHORT_LENS_ORG_ID=00000000-0000-0000-0000-000000000000
MCP_MAX_ROWS=50
